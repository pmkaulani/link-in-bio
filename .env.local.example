NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used for admin operations that bypass RLS (user deletion,
# admin table access). Get from Supabase Dashboard → Settings → API → service_role (secret).
# NEVER prefix with NEXT_PUBLIC_ — this key has full database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by middleware.js to tell your own domain apart from a customer's
# custom domain. Set this to your production domain once you have one.
NEXT_PUBLIC_APP_HOST=your-app-domain.com
