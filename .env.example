# ─── Link-in-Bio Production Environment Variables ─────────────────────────────
# Copy this file to .env.local for local development, or add these variables
# into your Vercel Project Settings (Settings -> Environment Variables).

# ── 1. Supabase Public Client Configuration ───────────────────────────────────
# Required for client-side queries, authentication, and realtime subscriptions.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL & anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── 2. Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_) ────────────
# Used exclusively by backend API routes (/api/admin/*, /api/analytics, /api/account/delete).
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── 3. Application Domain & Routing ───────────────────────────────────────────
# Primary site URL for canonical tags, OpenGraph metadata, and OAuth redirects.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_APP_HOST=your-domain.com

# ── 4. Platform Contact & Support Configuration ───────────────────────────────
# Centralized support and legal addresses (defaults to pmkaulani@gmail.com).
SUPPORT_EMAIL=pmkaulani@gmail.com
SECURITY_EMAIL=pmkaulani@gmail.com
PRIVACY_EMAIL=pmkaulani@gmail.com
LEGAL_EMAIL=pmkaulani@gmail.com
